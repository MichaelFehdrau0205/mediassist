# Copy this file to .env and fill in real values. .env is gitignored and must
# never be committed. Every secret the app uses lives here — none in source.

OPENROUTER_API_KEY=your_openrouter_key_here

# Optional: which model to use. Omit for the free tier (slow). For fast (~1-3s)
# replies, set a paid model — needs OpenRouter credit (a few cents per session):
#   MEDIASSIST_MODEL=openai/gpt-4o-mini
#   MEDIASSIST_MODEL=google/gemini-2.0-flash-001
MEDIASSIST_MODEL=openrouter/free
SENDGRID_API_KEY=your_sendgrid_key_here
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
LEGACY_DB_URL=postgresql://user:password@host:5432/dbname
INSURANCE_VERIFY_KEY=your_insurance_key_here
